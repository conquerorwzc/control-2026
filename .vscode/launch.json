{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "F4 DAPlink",
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.getLaunchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "device": "STM32F407IG",
            "svdFile": "${workspaceFolder}/Hardware/stm32-f4/STM32F407.svd",
            "servertype": "openocd",
            "configFiles": [
                "${workspaceFolder}/Debug/config/openocd_dap_f4.cfg"
            ],
            "runToEntryPoint": "main",
            "rtos": "FreeRTOS",
            "preLaunchTask": "CMake: build",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
